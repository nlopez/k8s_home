{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "regex",
    "kubernetes",
    "helm-values",
    "github-actions"
  ],
  "regexManagers": [
    {
      "description": "Update Helm chart versions in bootstrap ApplicationSet list entries",
      "managerFilePatterns": [
        "/^bootstrap\\/apps-helm\\.yaml$/"
      ],
      "matchStrings": [
        "- name:\\s*(?<appName>[^\\n]+)\\s*\\n\\s*repoURL:\\s*['\\\"]?(?<registryUrl>https?:\\/\\/[^\\s'\\\"]+)['\\\"]?\\s*\\n\\s*chart:\\s*['\\\"]?(?<depName>[^\\s'\\\"]+)['\\\"]?\\s*\\n\\s*targetRevision:\\s*['\\\"]?(?<currentValue>[^\\s'\\\"]+)['\\\"]?"
      ],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "{{{registryUrl}}}",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Update OCI-hosted Helm chart versions in bootstrap ApplicationSet list entries",
      "managerFilePatterns": [
        "/^bootstrap\\/apps-helm\\.yaml$/"
      ],
      "matchStrings": [
        "- name:\\s*(?<appName>[^\\n]+)\\s*\\n\\s*repoURL:\\s*['\\\"]?oci:\\/\\/(?<depName>[^\\s'\\\"]+)['\\\"]?\\s*\\n\\s*targetRevision:\\s*['\\\"]?(?<currentValue>[^\\s'\\\"]+)['\\\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Group Helm chart updates from bootstrap/apps-helm.yaml",
      "matchFileNames": [
        "bootstrap/apps-helm.yaml"
      ],
      "groupName": "helm chart updates"
    },
    {
      "description": "Group container image updates from manifests and Helm values",
      "matchManagers": [
        "kubernetes",
        "helm-values"
      ],
      "groupName": "container image updates"
    },
    {
      "description": "Use loose versioning for linuxserver images which use version-X.Y.Z tag format",
      "matchPackageNames": [
        "ghcr.io/linuxserver/**",
        "lscr.io/linuxserver/**"
      ],
      "versioning": "loose"
    },
    {
      "description": "Use calver versioning for media-toolbox which uses YYYY.M.D.HHmmss tags",
      "matchPackageNames": [
        "docker.io/nlopez/media-toolbox"
      ],
      "versioning": "calver"
    },
    {
      "description": "Ignore untagged or latest-pinned images that cannot meaningfully be updated",
      "matchPackageNames": [
        "bitnami/kubectl"
      ],
      "enabled": false
    },

    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions updates"
    }
  ]
}
